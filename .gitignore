# Built application files
*.apk
*.aar
*.ap_
*.aab

# 例外：正式发布包需要随仓库分发，可直接下载安装
!releases/*.apk

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle / build caches
.gradle/
.kotlin/
build/
app/build/

# Local configuration file (contains personal SDK path, e.g. sdk.dir)
local.properties

# Log/OS Files
*.log

# Android Studio / IntelliJ
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Keystore / signing files (never commit secrets)
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
local.keystore.properties

# Credential / environment files
*.env
.env*
